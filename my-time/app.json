{
  "expo": {
    "name": "My Time",
    "slug": "my-time",
    "scheme": "mytime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/prilampoInicio.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/prilampoInicio.png",
        "backgroundColor": "#121212"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.pedromatos88.mytime"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "plugins": [
            "expo-font",
            "expo-status-bar",
            [
              "expo-splash-screen",
              {
                "image": "./assets/abelhaInicio.png",
                "resizeMode": "contain",
                "backgroundColor": "#EAE7E1",
                "imageWidth": 180
              }
            ]
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "34d9f5f3-ee37-4775-81d6-fbc6ac2288e2"
      }
    }
  }
}
